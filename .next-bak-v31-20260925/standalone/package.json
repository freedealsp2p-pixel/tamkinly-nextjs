{
  "name": "tamkinly",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PRIVATE_DISABLE_TURBOPACK=1 NODE_OPTIONS='--max-old-space-size=384' next dev -p 3000 2>&1 | tee dev.log",
    "build": "NODE_OPTIONS='--max-old-space-size=1536' next build",
    "start": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=384' node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "postbuild": "mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/"
  },
