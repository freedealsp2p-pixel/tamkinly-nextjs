  "about": {
    "heroBadge": "قصتنا",
    "heroTitle": "عن ",
    "heroTitleHighlight": "تمكينلي",
    "heroSubtitle": "مساحة وُلدت من فهم أن التحول الحقيقي لا يأتي من إصلاح ما هو مكسور — بل من العودة إلى ما كان موجوداً دائماً.",
    "missionBadge": "مهمتنا",
    "missionTitle": "عُد إلى من أنت حقاً",
    "missionP1": "في عالم مهووس بتطوير الذات، نسينا شيئاً أساسياً: أنت لست مشروعاً يجب إكماله. لست مشكلة يجب حلها. لست مكسوراً.",
    "missionP2": "تمكينلي وُلد من فكرة بسيطة لكنها جذرية — أن الطريق إلى الأمام ليس في أن تصبح شخصاً جديداً، بل في أن تعود إلى من كنت دائماً تحت طبقات التوقعات والتنشئة وإدانة الذات.",
    "missionP3": "لا نقدّم حلولاً سريعة أو تحفيزاً مؤقتاً. نقدم أُطراً لعمل الهوية العميق الذي يخلق تحولاً دائماً من الداخل إلى الخارج.",
    "missionQuote": "الرحلة ليست في إضافة المزيد. بل في إزالة كل ما ليس أنت حقاً.",
    "missionQuoteAttrib": "— فلسفة تمكينلي",
    "valuesBadge": "قيمنا",
    "valuesTitle": "ما نؤمن به",
    "valuesSubtitle": "هذه ليست مجرد كلمات على صفحة. إنها المبادئ التي توجّه كل منتج نصنعه.",
    "value1Title": "بلا إدانة ذاتية",
    "value1Desc": "نقابلك حيث أنت، لا حيث 'يجب' أن تكون. نموّ بلا خجل.",
    "value2Title": "الهوية أولاً",
    "value2Desc": "التغيير الدائم يبدأ من مستوى الهوية، لا من مستوى السلوك.",
    "value3Title": "الإنسان في المركز",
    "value3Desc": "نصمم لبشر حقيقيين بتعقيدات حقيقية، لا لنُسخ مثالية.",
    "value4Title": "الوضوح فوق التعقيد",
    "value4Desc": "البسيط لا يعني السطحي. العمل العميق يمكن أن يكون جميل البساطة.",
    "value5Title": "التوجيه الذاتي",
    "value5Desc": "نقدم الخريطة، لكنك تختار الطريق. رحلتك هي ملكك.",
    "value6Title": "مستنير بالأدلة",
    "value6Desc": "مبني على علم النفس وعلوم الأعصاب ومبادئ التحول المثبتة.",
    "differentBadge": "ما يميزنا",
    "differentTitle": "لسنا علامة مساعدة ذاتية نموذجية",
    "diff1Title": "ليس مجرد مخطط آخر",
    "diff1Desc": "لا نعطيك صفحات فارغة لتملأها. كل سؤال وكل تمرين مصمم استراتيجياً ليقودك أعمق في فهم الذات.",
    "diff2Title": "بلا إيجابية سامة",
    "diff2Desc": "لن نخبرك 'فكّر بإيجابية فقط' أو 'اجذب أحلامك'. التحول الحقيقي يتطلب مواجهة ذات صادقة.",
    "diff3Title": "العمق لا الحيل",
    "diff3Desc": "النصائح السريعة لا تخلق تغييراً دائماً. نذهب عميقاً، لأن هناك يحدث التحول الحقيقي.",
    "diff4Title": "شراء لمرة واحدة",
    "diff4Desc": "لا اشتراكات. لا محاولات بيع إضافية. لا رسوم خفية. اشترِ مرة، امتلك للأبد — بما في ذلك جميع التحديثات المستقبلية.",
    "foundersBadge": "المؤسسون",
    "foundersTitle": "وُلد من التجربة، لا من النظرية",
    "foundersSubtitle": "لم نبدأ بخطة عمل. بدأنا بإدراك مشترك — أن الحياة التي نعيشها لم تكن الحياة القادرين عليها.",
    "foundersLive": "نبني مستقبل التحول الذاتي",
    "foundersQuoteP1": "كل منا أمضى سنوات في مطاردة نسخة 'أفضل' من نفسه — نقرأ الكتب، نحضر الورش، نتبع الخبراء. جرّبنا كل الطرق المتاحة، وبينما نجحت بعض الأشياء مؤقتاً، لم يخلق شيءٌ تغييراً حقيقياً ودائماً. لأنهم جميعاً كانوا يحاولون 'إصلاحنا'، وكأننا معطوبون.",
    "foundersQuoteP2": "ما اكتشفناه — من خلال صراعاتنا وإخفاقاتنا واختراقاتنا — أن الإجابة لم تكن في أن نصبح شخصاً جديداً، بل في تجريد كل ما لم يكن نحن حقاً. ليست النسخة الكاملة، بل النسخة التي تعيش بمعنى وهدف وأصالة. النسخة الأقوى والأصح والأجمل التي كانت دائماً هناك تحت الضجيج.",
    "foundersQuoteP3": "تمكينلي وُلد من تلك الرحلة المشتركة. لم نصنعه من كتب الدراسات — بنيناه من ندوب وحكمة تحولنا الشخصي. ونحن هنا لنسير معك في هذا الطريق.",
